{
    "name": "@pixel-brewery/remote-capacitor",
    "version": "0.1.0",
    "type": "module",
    "sideEffects": false,
    "license": "MIT",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "/dist/**",
        "/README.md",
        "/LICENSE",
        "/android/build.gradle.kts",
        "/android/gradle.properties",
        "/android/src/main/**",
        "/ios/sources/**",
        "/ios/tests/**",
        "/Package.swift",
        "!**/*.tsbuildinfo",
        "!.local/**",
        "!**/.local/**",
        "!**/.build/**",
        "!**/.gradle/**",
        "!**/.swiftpm/**",
        "!**/node_modules/**",
        "!android/build/**"
    ],
    "nx": {
        "name": "remote-capacitor"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "build": "tsc -b tsconfig.lib.json",
        "typecheck": "tsc -p tsconfig.spec.json --noEmit",
        "test": "vitest run --config vitest.config.ts"
    },
    "dependencies": {
        "@pixel-brewery/remote-browser": "workspace:*",
        "@pixel-brewery/remote-client": "workspace:*",
        "@pixel-brewery/remote-protocol": "workspace:*"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/pixel-brewery/remote.git",
        "directory": "libs/remote-capacitor"
    },
    "peerDependencies": {
        "@capacitor/core": ">=8.6.2 <9"
    },
    "capacitor": {
        "android": {
            "src": "android"
        },
        "ios": {
            "src": "ios"
        }
    }
}
