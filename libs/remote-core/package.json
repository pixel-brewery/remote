{
    "name": "@pixel-brewery/remote-core",
    "version": "0.2.0",
    "type": "module",
    "description": "Pairing, durable device authorization and scoped route admission.",
    "license": "MIT",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "!**/*.tsbuildinfo"
    ],
    "dependencies": {
        "@pixel-brewery/remote-protocol": "workspace:*"
    },
    "nx": {
        "name": "remote-core",
        "tags": [
            "runtime:portable"
        ]
    },
    "scripts": {
        "build": "tsc -b tsconfig.lib.json",
        "typecheck": "tsc --noEmit -p tsconfig.spec.json",
        "test": "vitest run --config vitest.config.ts"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://npm.pkg.github.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/pixel-brewery/remote.git",
        "directory": "libs/remote-core"
    }
}
