{
    "name": "@pixel-brewery/remote-workspace",
    "private": true,
    "version": "0.1.0",
    "description": "Product-neutral remote access, pairing and client runtimes for local desktop applications.",
    "type": "module",
    "license": "MIT",
    "packageManager": "yarn@4.18.1",
    "engines": {
        "node": ">=24.15.0"
    },
    "workspaces": [
        "libs/*",
        "apps/*",
        "infra/*"
    ],
    "scripts": {
        "agents:sync": "node tools/sync-agents.mjs --write",
        "agents:check": "node tools/sync-agents.mjs --check && node tools/check-bootstrap.mjs && nx run nx-tasks:architecture:check",
        "agents:mcp-check": "node tools/check-mosaik-mcp.mjs",
        "build": "nx run-many -t build --parallel=1",
        "typecheck": "nx run-many -t typecheck --parallel=1",
        "test": "nx run-many -t test --parallel=1",
        "lint": "nx run-many -t lint --parallel=1",
        "docs": "nx run nx-tasks:docs --parallel=1",
        "docs:check": "nx run nx-tasks:docs:check --parallel=1",
        "verify": "yarn agents:check && yarn agents:mcp-check && yarn source:check && yarn format:check && yarn build && yarn typecheck && yarn test && yarn native:check && yarn theme:check && yarn packages:check && yarn docs:check",
        "native:generate": "nx run nx-tasks:native:generate",
        "native:check": "nx run nx-tasks:native:check",
        "source:check": "nx run nx-tasks:source:check",
        "format": "nx run nx-tasks:format",
        "format:check": "nx run nx-tasks:format:check",
        "packages:check": "nx run nx-tasks:packages:check",
        "theme:generate": "nx run nx-tasks:theme:generate",
        "theme:check": "nx run nx-tasks:theme:check",
        "release:preflight": "nx run nx-tasks:packages:release:preflight",
        "release:prepare": "nx run nx-tasks:packages:release:prepare",
        "release:publish": "nx run nx-tasks:packages:release:publish",
        "release:verify": "nx run nx-tasks:packages:release:verify"
    },
    "devDependencies": {
        "@angular/core": "22.2.6",
        "@capacitor/android": "8.6.2",
        "@capacitor/core": "8.6.2",
        "@capacitor/ios": "8.6.2",
        "@floating-ui/dom": "1.8.0",
        "@fontsource-variable/inter": "5.3.0",
        "@lit-labs/virtualizer": "2.1.1",
        "@lit/context": "1.1.6",
        "@lit/task": "1.0.3",
        "@nx/devkit": "24.0.5",
        "@nx/js": "24.0.5",
        "@pixel-brewery/mosaik-elements-foundation": "0.1.205",
        "@pixel-brewery/mosaik-icons": "0.1.205",
        "@pixel-brewery/mosaik-mcp": "0.1.205",
        "@pixel-brewery/mosaik-themes": "0.1.205",
        "@playwright/test": "1.65.1",
        "@swc/helpers": "~0.5.18",
        "@types/node": "26.6.6",
        "@types/ws": "8.18.2",
        "chroma-js": "3.3.0",
        "electron": "45.5.0",
        "lit": "3.3.3",
        "nx": "24.0.5",
        "playwright": "1.65.1",
        "preact": "11.2.0",
        "prettier": "3.10.1",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "tslib": "^2.3.0",
        "typescript": "6.0.3",
        "vite": "8.3.8",
        "vitest": "5.1.1",
        "ws": "8.23.0",
        "zod": "4.6.7"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/pixel-brewery/remote.git"
    },
    "homepage": "https://pixel-brewery.github.io/remote/"
}
