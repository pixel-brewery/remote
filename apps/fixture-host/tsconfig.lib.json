{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "types": ["node"],
        "lib": ["ES2024", "DOM"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.spec.ts"],
    "references": [
        { "path": "../../libs/remote-protocol/tsconfig.lib.json" },
        { "path": "../../libs/remote-core/tsconfig.lib.json" },
        { "path": "../../libs/remote-node/tsconfig.lib.json" }
    ]
}
