                    "text": "Writes and flushes a private temporary file before an atomic replacement."
                  }
                ],
                "blockTags": [
                  {
                    "tag": "@returns",
                    "content": [
                      {
                        "kind": "text",
                        "text": "Resolves only after the replacement commits; rejects without changing the previous record."
                      }
                    ]
                  },
                  {
                    "tag": "@remarks",
                    "content": [
                      {
                        "kind": "text",
                        "text": "Temporary files use exclusive creation and mode 0600. The file is flushed before atomic rename. Use one writer per installation."
                      }
                    ]
                  },
                  {
